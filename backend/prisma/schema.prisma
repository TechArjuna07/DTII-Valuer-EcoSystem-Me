// Valuers Ecosystem — PostgreSQL schema (Prisma).
//
// Conventions
//  - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
//  - snake_case tables/columns via @@map / @map; camelCase in JavaScript.
//  - Every firm-owned table carries firm_id; tenant scoping is enforced in services/access policy.
//  - Append-only tables (audit_logs, ...) are protected by triggers + grants in the migration SQL.
//  - Migrations are generated with `prisma migrate dev --create-only` and REVIEWED: hand-written SQL
//    (extensions, triggers, grants, partial indexes) lives in the migration files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // runtime role valuers_app
  directUrl = env("DATABASE_MIGRATION_URL") // owner role valuers_owner (migrations)
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  PLATFORM
  FIRM
}

enum AuthTokenPurpose {
  INVITE
  PASSWORD_RESET
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

// ───────────────────────────── Tenancy ─────────────────────────────

/// A valuation firm (tenant). firm_code is generated once (FIRM001, FIRM002, ...) and never changes.
model Organization {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmCode              String             @unique @map("firm_code") @db.VarChar(16)
  name                  String             @db.VarChar(200)
  legalName             String?            @map("legal_name") @db.VarChar(200)
  registrationNo        String?            @map("registration_no") @db.VarChar(64)
  gstin                 String?            @db.VarChar(15)
  email                 String             @db.Citext
  phone                 String?            @db.VarChar(20)
  addressLine1          String?            @map("address_line1") @db.VarChar(200)
  addressLine2          String?            @map("address_line2") @db.VarChar(200)
  city                  String?            @db.VarChar(100)
  state                 String?            @db.VarChar(100)
  pincode               String?            @db.VarChar(10)
  status                OrganizationStatus @default(ACTIVE)
  subscriptionPlan      String             @default("STANDARD") @map("subscription_plan") @db.VarChar(40)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  subscriptionValidTill DateTime?          @map("subscription_valid_till") @db.Date
  maxUsers              Int?               @map("max_users")
  createdById           String?            @map("created_by_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  settings            OrganizationSettings?
  userRoles           UserRole[]
  firmRolePermissions FirmRolePermission[]
  employees           EmployeeProfile[]
  clients             Client[]
  sequences           FirmSequence[]
  banks               Bank[]
  categories          ValuationCategory[]
  documentTypes       DocumentType[]
  cases               ValuationCase[]
  caseCounters        CaseCounter[]
  reportTemplates     ReportTemplate[]

  @@index([status])
  @@map("organizations")
}

/// Per-firm human-readable code counters (EMP-000001, CLT-000001). Incremented with a row-locking upsert
/// inside the business transaction, so codes are unique and gap-free (a rollback releases the number).
model FirmSequence {
  firmId    String   @map("firm_id") @db.Uuid
  entity    String   @db.VarChar(20)
  lastValue BigInt   @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@id([firmId, entity])
  @@map("firm_sequences")
}

/// Firm-level configuration. Secrets (SMTP) are AES-256-GCM encrypted and never returned by the API.
model OrganizationSettings {
  firmId          String   @id @map("firm_id") @db.Uuid
  branding        Json     @default("{}")
  smtpProvider    String?  @map("smtp_provider") @db.VarChar(20)
  smtpConfig      Json?    @map("smtp_config")
  smtpSecretEnc   Bytes?   @map("smtp_secret_enc")
  slaConfig       Json     @default("{}") @map("sla_config")
  workflowOptions Json     @default("{}") @map("workflow_options")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

// ───────────────────────────── Identity & RBAC ─────────────────────────────

/// One login per person (email). Firm roles are granted through user_roles. Superadmin is platform-level.
model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique @db.Citext
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  fullName          String     @map("full_name") @db.VarChar(150)
  phone             String?    @db.VarChar(20)
  isSuperadmin      Boolean    @default(false) @map("is_superadmin")
  status            UserStatus @default(INVITED)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(3)

  roles      UserRole[]
  sessions   UserSession[]
  authTokens AuthToken[]
  employee   EmployeeProfile[]
  clients    Client[]

  @@index([status])
  @@map("users")
}

// ───────────────────────────── Firm masters: employees & clients ─────────────────────────────

enum ClientType {
  INDIVIDUAL
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  HUF
  TRUST
  OTHER
}

/// Firm employee (one per user per firm). Roles are held in user_roles.
model EmployeeProfile {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId         String       @map("firm_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  employeeCode   String       @map("employee_code") @db.VarChar(20)
  designation    String?      @db.VarChar(100)
  department     String?      @db.VarChar(100)
  /// IBBI / bank empanelment / engineer registration number (shown on signed reports).
  registrationNo String?      @map("registration_no") @db.VarChar(64)
  dateOfJoining  DateTime?    @map("date_of_joining") @db.Date
  status         RecordStatus @default(ACTIVE)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  assignments CaseAssignment[]
  inspections PropertyInspection[]

  @@unique([firmId, id])
  @@unique([firmId, userId])
  @@unique([firmId, employeeCode])
  @@index([firmId, status])
  @@map("employee_profiles")
}

/// Firm client (loan applicant / property owner). PAN is AES-256-GCM encrypted; pan_hmac allows duplicate
/// detection without decrypting. user_id links the optional client-portal login.
model Client {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId        String       @map("firm_id") @db.Uuid
  clientCode    String       @map("client_code") @db.VarChar(20)
  clientType    ClientType   @map("client_type")
  name          String       @db.VarChar(200)
  contactPerson String?      @map("contact_person") @db.VarChar(150)
  email         String?      @db.Citext
  phone         String?      @db.VarChar(20)
  altPhone      String?      @map("alt_phone") @db.VarChar(20)
  panEnc        Bytes?       @map("pan_enc")
  panHmac       String?      @map("pan_hmac") @db.VarChar(64)
  panLast4      String?      @map("pan_last4") @db.VarChar(4)
  gstin         String?      @db.VarChar(15)
  addressLine1  String?      @map("address_line1") @db.VarChar(200)
  addressLine2  String?      @map("address_line2") @db.VarChar(200)
  city          String?      @db.VarChar(100)
  state         String?      @db.VarChar(100)
  pincode       String?      @db.VarChar(10)
  notes         String?      @db.VarChar(1000)
  userId        String?      @map("user_id") @db.Uuid
  status        RecordStatus @default(ACTIVE)
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  cases        ValuationCase[]

  @@unique([firmId, id])
  @@unique([firmId, clientCode])
  @@unique([firmId, panHmac])
  @@unique([firmId, userId])
  @@index([firmId, status])
  @@index([firmId, name])
  @@map("clients")
}

/// System roles: SUPER_ADMIN (platform), FIRM_ADMIN, MARKETING, FIELD_OFFICER, JUNIOR_REVIEWER, SENIOR_REVIEWER, CLIENT.
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String    @unique @db.VarChar(40)
  name        String    @db.VarChar(80)
  description String?   @db.VarChar(300)
  scope       RoleScope @default(FIRM)
  isSystem    Boolean   @default(true) @map("is_system")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions         RolePermission[]
  firmRolePermissions FirmRolePermission[]
  userRoles           UserRole[]

  @@map("roles")
}

/// Fine-grained permission, e.g. case.create, case.assign.field, valuation.approve.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(40)
  description String   @db.VarChar(300)
  /// Critical permissions (workflow integrity) cannot be toggled by a firm.
  isCritical  Boolean  @default(false) @map("is_critical")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles               RolePermission[]
  firmRolePermissions FirmRolePermission[]

  @@map("permissions")
}

/// Platform default permission set of each role.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Firm-specific override of a (non-critical) role permission: granted=false revokes, true adds.
model FirmRolePermission {
  firmId       String   @map("firm_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  granted      Boolean
  updatedById  String?  @map("updated_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([firmId, roleId, permissionId])
  @@map("firm_role_permissions")
}

/// Grants a firm role to a user. A user may hold several roles in one firm (small firms).
model UserRole {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  firmId      String       @map("firm_id") @db.Uuid
  roleId      String       @map("role_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [firmId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, firmId, roleId])
  @@index([firmId, roleId, status])
  @@map("user_roles")
}

/// Refresh-token session (one per device/login). Tokens are stored as SHA-256 hashes and rotated on use;
/// reuse of a rotated token revokes the whole family.
model UserSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  familyId      String    @map("family_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  firmId        String?   @map("firm_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(400)
  ip            String?   @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt     DateTime? @map("rotated_at") @db.Timestamptz(3)
  /// Successor session after rotation (used for the concurrent-tab grace window).
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(40)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("user_sessions")
}

/// Single-use invite / password-reset token (stored as SHA-256 hash).
model AuthToken {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  purpose     AuthTokenPurpose
  tokenHash   String           @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?        @map("used_at") @db.Timestamptz(3)
  createdById String?          @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ───────────────────────────── Platform masters ─────────────────────────────

/// Indian financial year (1 April – 31 March). code "2026-27", shortCode "2627" (used in Case IDs).
model FinancialYear {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String              @unique @db.VarChar(7)
  shortCode String              @unique @map("short_code") @db.VarChar(4)
  label     String              @db.VarChar(20)
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    FinancialYearStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  cases    ValuationCase[]
  counters CaseCounter[]

  @@map("financial_years")
}

// ───────────────────────────── Audit ─────────────────────────────

/// Platform & firm security/audit trail. APPEND-ONLY: UPDATE/DELETE are blocked by trigger and grants.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId     String?  @map("firm_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role") @db.VarChar(40)
  action     String   @db.VarChar(80)
  entityType String?  @map("entity_type") @db.VarChar(60)
  entityId   String?  @map("entity_id") @db.Uuid
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(400)
  requestId  String?  @map("request_id") @db.VarChar(64)
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([firmId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// ───────────────────────────── Phase 4: masters & case management ─────────────────────────────

enum InstitutionType {
  BANK
  NBFC
  HFC
  COOPERATIVE_BANK
  OTHER
}

/// Bank / NBFC master (per firm; one row per institution branch the firm is empanelled with).
model Bank {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId                 String          @map("firm_id") @db.Uuid
  institutionType        InstitutionType @map("institution_type")
  name                   String          @db.VarChar(150)
  /// Short code used in repository folder names, e.g. HDFC, SBI.
  shortCode              String          @map("short_code") @db.VarChar(20)
  branch                 String?         @db.VarChar(150)
  ifsc                   String?         @db.VarChar(11)
  contactPerson          String?         @map("contact_person") @db.VarChar(150)
  email                  String?         @db.Citext
  phone                  String?         @db.VarChar(20)
  address                String?         @db.VarChar(400)
  /// Whether this lender requires client approval + signature before submission.
  requiresClientApproval Boolean         @default(true) @map("requires_client_approval")
  status                 RecordStatus    @default(ACTIVE)
  createdById            String?         @map("created_by_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?       @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [firmId], references: [id], onDelete: Restrict)
  cases        ValuationCase[]

  @@unique([firmId, id])
  @@index([firmId, status])
  @@map("banks")
}

/// Valuation category (Land & Building, Plant & Machinery, Stock…). firm_id NULL = platform category for all firms.
model ValuationCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId        String?  @map("firm_id") @db.Uuid
  code          String   @db.VarChar(40)
  name          String   @db.VarChar(100)
  description   String?  @db.VarChar(400)
  /// Calculation engine used by valuation reports: LAND_BUILDING | PLANT_MACHINERY | STOCK.
  engine        String   @db.VarChar(40)
  fieldsVersion Int      @default(1) @map("fields_version")
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?             @relation(fields: [firmId], references: [id], onDelete: Restrict)
  fields       CategoryFieldDefinition[]
  cases        ValuationCase[]

  @@index([firmId, active])
  @@map("valuation_categories")
}

/// Configurable property/asset field of a category (rendered as a dynamic form, validated server-side).
model CategoryFieldDefinition {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  section    String   @db.VarChar(80)
  key        String   @db.VarChar(60)
  label      String   @db.VarChar(120)
  /// TEXT | TEXTAREA | NUMBER | AREA | CURRENCY | DATE | SELECT | BOOLEAN
  type       String   @db.VarChar(20)
  required   Boolean  @default(false)
  options    Json?
  unit       String?  @db.VarChar(20)
  helpText   String?  @map("help_text") @db.VarChar(300)
  sortOrder  Int      @default(0) @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category ValuationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@map("category_field_definitions")
}

/// Document type master. firm_id NULL = platform default.
model DocumentType {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId        String?  @map("firm_id") @db.Uuid
  code          String   @db.VarChar(40)
  name          String   @db.VarChar(120)
  defaultFolder String   @map("default_folder") @db.VarChar(40)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [firmId], references: [id], onDelete: Restrict)

  @@index([firmId, active])
  @@map("document_types")
}

enum CaseStatus {
  CASE_RECEIVED
  INSPECTION_ASSIGNED
  INSPECTION_IN_PROGRESS
  INSPECTION_COMPLETED
  PRELIMINARY_VALUATION_IN_PROGRESS
  PRELIMINARY_SUBMITTED
  FINAL_REVIEW_IN_PROGRESS
  SENT_BACK_FOR_CORRECTION
  FINAL_APPROVED
  CLIENT_APPROVAL_PENDING
  CLIENT_QUERY_RAISED
  CLIENT_APPROVED
  CLIENT_SIGNED
  SUBMITTED_TO_BANK
  LOAN_SANCTIONED
  DISBURSED
  CASE_COMPLETED
  CASE_ON_HOLD
  CASE_CANCELLED
  CASE_REJECTED
}

enum CasePriority {
  NORMAL
  HIGH
  URGENT
}

enum AssignmentStage {
  MARKETING
  FIELD
  JUNIOR
  SENIOR
}

/// Per firm × financial year Case ID counter (row-locked upsert inside the case-creation transaction).
model CaseCounter {
  firmId          String   @map("firm_id") @db.Uuid
  financialYearId String   @map("financial_year_id") @db.Uuid
  lastValue       BigInt   @default(0) @map("last_value")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [firmId], references: [id], onDelete: Restrict)
  financialYear FinancialYear @relation(fields: [financialYearId], references: [id], onDelete: Restrict)

  @@id([firmId, financialYearId])
  @@map("case_counters")
}

/// A valuation case. case_number (VAL-FIRM001-FY2627-000001) is permanent and globally unique.
model ValuationCase {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId            String       @map("firm_id") @db.Uuid
  caseNumber        String       @unique @map("case_number") @db.VarChar(40)
  seq               Int
  clientId          String       @map("client_id") @db.Uuid
  bankId            String       @map("bank_id") @db.Uuid
  financialYearId   String       @map("financial_year_id") @db.Uuid
  categoryId        String       @map("category_id") @db.Uuid
  status            CaseStatus   @default(CASE_RECEIVED)
  holdFromStatus    CaseStatus?  @map("hold_from_status")
  priority          CasePriority @default(NORMAL)
  loanType          String?      @map("loan_type") @db.VarChar(80)
  loanReference     String?      @map("loan_reference") @db.VarChar(80)
  loanAmount        Decimal?     @map("loan_amount") @db.Decimal(18, 2)
  propertyAddress   String?      @map("property_address") @db.VarChar(500)
  propertyCity      String?      @map("property_city") @db.VarChar(100)
  description       String?      @db.VarChar(1000)
  receivedOn        DateTime     @default(now()) @map("received_on") @db.Date
  dueDate           DateTime?    @map("due_date") @db.Date
  statusChangedAt   DateTime     @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  isOverdue         Boolean      @default(false) @map("is_overdue")
  awaitingDocuments Boolean      @default(false) @map("awaiting_documents")
  closureReason     String?      @map("closure_reason") @db.VarChar(500)
  closedAt          DateTime?    @map("closed_at") @db.Timestamptz(3)
  rowVersion        Int          @default(0) @map("row_version")
  createdById       String       @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization         @relation(fields: [firmId], references: [id], onDelete: Restrict)
  client        Client               @relation(fields: [firmId, clientId], references: [firmId, id], onDelete: Restrict)
  bank          Bank                 @relation(fields: [firmId, bankId], references: [firmId, id], onDelete: Restrict)
  financialYear FinancialYear        @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  category      ValuationCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignments   CaseAssignment[]
  statusHistory CaseStatusHistory[]
  activities    CaseActivity[]
  documents     CaseDocument[]
  docRequests   DocumentRequest[]
  property      PropertyDetails?
  inspections   PropertyInspection[]
  reports       ValuationReport[]
  approvals     ClientApproval[]
  signatures    DigitalSignature[]
  submissions   BankSubmission[]
  sanction      LoanSanction?
  disbursements LoanDisbursement[]

  @@unique([firmId, id])
  @@index([firmId, status])
  @@index([firmId, clientId])
  @@index([firmId, financialYearId])
  @@index([firmId, bankId])
  @@index([firmId, createdAt(sort: Desc)])
  @@map("valuation_cases")
}

/// Who works on a case at each stage. One ACTIVE assignment per stage (partial unique index in SQL).
model CaseAssignment {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String          @map("firm_id") @db.Uuid
  caseId       String          @map("case_id") @db.Uuid
  employeeId   String          @map("employee_id") @db.Uuid
  stage        AssignmentStage
  assignedById String          @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt      DateTime?       @map("ended_at") @db.Timestamptz(3)
  endReason    String?         @map("end_reason") @db.VarChar(200)

  case     ValuationCase   @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)
  employee EmployeeProfile @relation(fields: [firmId, employeeId], references: [firmId, id], onDelete: Restrict)

  @@index([firmId, employeeId, endedAt])
  @@index([caseId, stage])
  @@map("case_assignments")
}

/// Status transitions (append-only). Used for TAT / SLA analytics.
model CaseStatusHistory {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId     String      @map("firm_id") @db.Uuid
  caseId     String      @map("case_id") @db.Uuid
  fromStatus CaseStatus? @map("from_status")
  toStatus   CaseStatus  @map("to_status")
  actorId    String?     @map("actor_id") @db.Uuid
  actorRole  String?     @map("actor_role") @db.VarChar(40)
  remarks    String?     @db.VarChar(1000)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("case_status_history")
}

/// Case activity timeline (append-only): every action, with actor, role, statuses, IP and document reference.
model CaseActivity {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId            String      @map("firm_id") @db.Uuid
  caseId            String      @map("case_id") @db.Uuid
  action            String      @db.VarChar(80)
  actorId           String?     @map("actor_id") @db.Uuid
  actorRole         String?     @map("actor_role") @db.VarChar(40)
  prevStatus        CaseStatus? @map("prev_status")
  newStatus         CaseStatus? @map("new_status")
  documentVersionId String?     @map("document_version_id") @db.Uuid
  ip                String?     @db.VarChar(64)
  remarks           String?     @db.VarChar(1000)
  meta              Json        @default("{}")
  /// Shown to the client in their portal timeline.
  clientVisible     Boolean     @default(false) @map("client_visible")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([firmId, createdAt(sort: Desc)])
  @@map("case_activities")
}

// ───────────────────────────── Phase 5: document repository ─────────────────────────────

enum CaseFolder {
  SOURCE_FILES
  INSPECTION_DOCUMENTS
  PROPERTY_PHOTOGRAPHS
  PRELIMINARY_VALUATION
  SENIOR_REVIEW
  FINAL_VALUATION_REPORT
  CLIENT_SIGNED_FILES
  BANK_SUBMISSION
  SANCTION_DOCUMENTS
  DISBURSEMENT_DOCUMENTS
}

enum DocumentVisibility {
  INTERNAL
  CLIENT
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  ERROR
}

enum UploadSource {
  STAFF
  CLIENT
  SYSTEM
  SIGNATURE
}

enum DocumentRequestStatus {
  OPEN
  FULFILLED
  CANCELLED
}

/// A logical document in a case folder. Content lives in immutable versions; the current version is the latest.
model CaseDocument {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId           String             @map("firm_id") @db.Uuid
  caseId           String             @map("case_id") @db.Uuid
  folder           CaseFolder
  documentTypeId   String?            @map("document_type_id") @db.Uuid
  title            String             @db.VarChar(200)
  visibility       DocumentVisibility @default(INTERNAL)
  currentVersionId String?            @map("current_version_id") @db.Uuid
  versionCount     Int                @default(0) @map("version_count")
  createdById      String             @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt       DateTime?          @map("archived_at") @db.Timestamptz(3)
  archivedById     String?            @map("archived_by_id") @db.Uuid
  archiveReason    String?            @map("archive_reason") @db.VarChar(500)

  case     ValuationCase     @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)
  versions DocumentVersion[]

  @@unique([firmId, id])
  @@index([caseId, folder])
  @@map("case_documents")
}

/// Immutable file version. storage_key is opaque (ids only); sha256 proves integrity.
model DocumentVersion {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String       @map("firm_id") @db.Uuid
  documentId   String       @map("document_id") @db.Uuid
  version      Int
  storageKey   String       @unique @map("storage_key") @db.VarChar(300)
  originalName String       @map("original_name") @db.VarChar(255)
  mimeType     String       @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt       @map("size_bytes")
  sha256       String       @db.VarChar(64)
  scanStatus   ScanStatus   @default(PENDING) @map("scan_status")
  scannedAt    DateTime?    @map("scanned_at") @db.Timestamptz(3)
  uploadSource UploadSource @default(STAFF) @map("upload_source")
  uploadedById String?      @map("uploaded_by_id") @db.Uuid
  note         String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  document CaseDocument @relation(fields: [firmId, documentId], references: [firmId, id], onDelete: Restrict)

  @@unique([documentId, version])
  @@index([firmId, createdAt])
  @@map("document_versions")
}

/// A missing document / clarification requested from the client, the bank or internally.
model DocumentRequest {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId              String                @map("firm_id") @db.Uuid
  caseId              String                @map("case_id") @db.Uuid
  documentTypeId      String?               @map("document_type_id") @db.Uuid
  title               String                @db.VarChar(200)
  description         String?               @db.VarChar(1000)
  requestedFrom       String                @default("CLIENT") @map("requested_from") @db.VarChar(20)
  status              DocumentRequestStatus @default(OPEN)
  dueDate             DateTime?             @map("due_date") @db.Date
  requestedById       String                @map("requested_by_id") @db.Uuid
  fulfilledDocumentId String?               @map("fulfilled_document_id") @db.Uuid
  fulfilledById       String?               @map("fulfilled_by_id") @db.Uuid
  fulfilledAt         DateTime?             @map("fulfilled_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, status])
  @@map("document_requests")
}

// ───────────────────────────── Phase 6: property details & inspection ─────────────────────────────

enum PropertyCondition {
  EXCELLENT
  GOOD
  AVERAGE
  POOR
  DILAPIDATED
}

enum InspectionStatus {
  DRAFT
  SUBMITTED
}

enum PhotoKind {
  PROPERTY
  LOCATION
  LANDMARK
  OTHER
}

/// Category-specific property / asset data (validated against category_field_definitions).
model PropertyDetails {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId        String   @map("firm_id") @db.Uuid
  caseId        String   @unique @map("case_id") @db.Uuid
  fieldsVersion Int      @map("fields_version")
  data          Json     @default("{}")
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@unique([firmId, caseId])
  @@map("property_details")
}

/// Site inspection. One row per round; a re-inspection requested by the senior reviewer starts a new round.
model PropertyInspection {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId            String             @map("firm_id") @db.Uuid
  caseId            String             @map("case_id") @db.Uuid
  round             Int                @default(1)
  officerId         String             @map("officer_id") @db.Uuid
  status            InspectionStatus   @default(DRAFT)
  scheduledAt       DateTime?          @map("scheduled_at") @db.Timestamptz(3)
  startedAt         DateTime?          @map("started_at") @db.Timestamptz(3)
  inspectedAt       DateTime?          @map("inspected_at") @db.Timestamptz(3)
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(3)
  gpsLat            Decimal?           @map("gps_lat") @db.Decimal(10, 7)
  gpsLng            Decimal?           @map("gps_lng") @db.Decimal(10, 7)
  gpsAccuracyM      Decimal?           @map("gps_accuracy_m") @db.Decimal(8, 2)
  gpsCapturedAt     DateTime?          @map("gps_captured_at") @db.Timestamptz(3)
  gpsConsent        Boolean?           @map("gps_consent")
  gpsDeclinedReason String?            @map("gps_declined_reason") @db.VarChar(300)
  propertyType      String?            @map("property_type") @db.VarChar(80)
  propertyAddress   String?            @map("property_address") @db.VarChar(500)
  landArea          Decimal?           @map("land_area") @db.Decimal(14, 3)
  landAreaUnit      String?            @map("land_area_unit") @db.VarChar(20)
  buildingArea      Decimal?           @map("building_area") @db.Decimal(14, 3)
  buildingAreaUnit  String?            @map("building_area_unit") @db.VarChar(20)
  condition         PropertyCondition?
  construction      Json               @default("{}")
  landmarks         Json               @default("[]")
  boundaries        Json               @default("{}")
  observations      Json               @default("{}")
  officerRemarks    String?            @map("officer_remarks") @db.VarChar(3000)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  case    ValuationCase     @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)
  officer EmployeeProfile   @relation(fields: [firmId, officerId], references: [firmId, id], onDelete: Restrict)
  photos  InspectionPhoto[]

  @@unique([firmId, id])
  @@unique([caseId, round])
  @@index([firmId, officerId, status])
  @@index([firmId, scheduledAt])
  @@map("property_inspections")
}

/// A photograph taken during an inspection; the image itself is a document in 03_Property_Photographs.
model InspectionPhoto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId       String    @map("firm_id") @db.Uuid
  inspectionId String    @map("inspection_id") @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  kind         PhotoKind @default(PROPERTY)
  caption      String?   @db.VarChar(300)
  gpsLat       Decimal?  @map("gps_lat") @db.Decimal(10, 7)
  gpsLng       Decimal?  @map("gps_lng") @db.Decimal(10, 7)
  capturedAt   DateTime? @map("captured_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  inspection PropertyInspection @relation(fields: [firmId, inspectionId], references: [firmId, id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

// ───────────────────────────── Phase 7: valuation reports & templates ─────────────────────────────

enum ReportStage {
  PRELIMINARY
  FINAL
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  RETURNED
  REJECTED
}

/// One preliminary and one final report per case; content lives in immutable versions.
model ValuationReport {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId           String       @map("firm_id") @db.Uuid
  caseId           String       @map("case_id") @db.Uuid
  stage            ReportStage
  status           ReportStatus @default(DRAFT)
  engine           String       @db.VarChar(40)
  currentVersionId String?      @map("current_version_id") @db.Uuid
  versionCount     Int          @default(0) @map("version_count")
  templateId       String?      @map("template_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  case     ValuationCase            @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)
  versions ValuationReportVersion[]

  @@unique([firmId, id])
  @@unique([caseId, stage])
  @@map("valuation_reports")
}

/// Immutable report version: inputs, server-computed calculation, values and the rendered / uploaded PDF.
model ValuationReportVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId            String   @map("firm_id") @db.Uuid
  reportId          String   @map("report_id") @db.Uuid
  version           Int
  inputs            Json
  calculation       Json
  marketValue       Decimal  @map("market_value") @db.Decimal(18, 2)
  realisableValue   Decimal  @map("realisable_value") @db.Decimal(18, 2)
  distressValue     Decimal  @map("distress_value") @db.Decimal(18, 2)
  guidelineValue    Decimal? @map("guideline_value") @db.Decimal(18, 2)
  insurableValue    Decimal? @map("insurable_value") @db.Decimal(18, 2)
  summary           String?  @db.VarChar(5000)
  changeNote        String?  @map("change_note") @db.VarChar(1000)
  documentId        String?  @map("document_id") @db.Uuid
  documentVersionId String?  @map("document_version_id") @db.Uuid
  templateVersionId String?  @map("template_version_id") @db.Uuid
  /// Public verification code printed (with a QR code) on final reports.
  verificationCode  String?  @unique @map("verification_code") @db.VarChar(40)
  preparedById      String   @map("prepared_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  report  ValuationReport @relation(fields: [firmId, reportId], references: [firmId, id], onDelete: Restrict)
  reviews ReportReview[]

  @@unique([firmId, id])
  @@unique([reportId, version])
  @@map("valuation_report_versions")
}

/// Senior reviewer decision on a preliminary version (append-only).
model ReportReview {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId          String         @map("firm_id") @db.Uuid
  reportVersionId String         @map("report_version_id") @db.Uuid
  reviewerId      String         @map("reviewer_id") @db.Uuid
  decision        ReviewDecision
  comments        String?        @db.VarChar(3000)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  version ValuationReportVersion @relation(fields: [firmId, reportVersionId], references: [firmId, id], onDelete: Restrict)

  @@index([reportVersionId])
  @@map("report_reviews")
}

/// Bank / NBFC-specific report format (Handlebars HTML). bank_id / category_id NULL = applies to all.
model ReportTemplate {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId           String       @map("firm_id") @db.Uuid
  name             String       @db.VarChar(150)
  description      String?      @db.VarChar(500)
  bankId           String?      @map("bank_id") @db.Uuid
  categoryId       String?      @map("category_id") @db.Uuid
  status           RecordStatus @default(ACTIVE)
  currentVersionId String?      @map("current_version_id") @db.Uuid
  versionCount     Int          @default(0) @map("version_count")
  createdById      String       @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [firmId], references: [id], onDelete: Restrict)
  versions     ReportTemplateVersion[]

  @@unique([firmId, id])
  @@index([firmId, bankId, categoryId])
  @@map("report_templates")
}

model ReportTemplateVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  version     Int
  bodyHtml    String   @map("body_html")
  changeNote  String?  @map("change_note") @db.VarChar(500)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  template ReportTemplate @relation(fields: [firmId, templateId], references: [firmId, id], onDelete: Restrict)

  @@unique([templateId, version])
  @@map("report_template_versions")
}

// ───────────────────────────── Phase 8: client approval & digital signatures ─────────────────────────────

enum ApprovalDecision {
  APPROVED
  QUERY
}

enum SignerRole {
  VALUER
  CLIENT
}

enum SignatureStatus {
  PENDING
  SIGNED
  FAILED
  CANCELLED
  EXPIRED
}

enum SignatureVerification {
  UNVERIFIED
  VERIFIED
  INVALID
}

/// Client decision on a released final report version (append-only).
model ClientApproval {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId          String           @map("firm_id") @db.Uuid
  caseId          String           @map("case_id") @db.Uuid
  reportVersionId String           @map("report_version_id") @db.Uuid
  decision        ApprovalDecision
  comments        String?          @db.VarChar(3000)
  clientUserId    String           @map("client_user_id") @db.Uuid
  ip              String?          @db.VarChar(64)
  userAgent       String?          @map("user_agent") @db.VarChar(400)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("client_approvals")
}

/// A digital signature request / record on a document version, with provider and verification details.
/// Uploaded images of signatures are never accepted: every record comes from a signature provider.
model DigitalSignature {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId             String                @map("firm_id") @db.Uuid
  caseId             String                @map("case_id") @db.Uuid
  sourceVersionId    String                @map("source_version_id") @db.Uuid
  signedVersionId    String?               @map("signed_version_id") @db.Uuid
  reportVersionId    String?               @map("report_version_id") @db.Uuid
  signerUserId       String                @map("signer_user_id") @db.Uuid
  signerRole         SignerRole            @map("signer_role")
  signerName         String                @map("signer_name") @db.VarChar(150)
  signerEmail        String                @map("signer_email") @db.Citext
  provider           String                @db.VarChar(30)
  providerRef        String?               @map("provider_ref") @db.VarChar(120)
  status             SignatureStatus       @default(PENDING)
  documentSha256     String                @map("document_sha256") @db.VarChar(64)
  signedSha256       String?               @map("signed_sha256") @db.VarChar(64)
  certSubject        String?               @map("cert_subject") @db.VarChar(400)
  certIssuer         String?               @map("cert_issuer") @db.VarChar(400)
  certSerial         String?               @map("cert_serial") @db.VarChar(120)
  certValidFrom      DateTime?             @map("cert_valid_from") @db.Timestamptz(3)
  certValidTo        DateTime?             @map("cert_valid_to") @db.Timestamptz(3)
  signatureAlgorithm String?               @map("signature_algorithm") @db.VarChar(60)
  signatureValue     String?               @map("signature_value")
  verificationStatus SignatureVerification @default(UNVERIFIED) @map("verification_status")
  verificationDetail Json                  @default("{}") @map("verification_detail")
  legallyValid       Boolean               @default(false) @map("legally_valid")
  consentText        String                @map("consent_text") @db.VarChar(1000)
  ip                 String?               @db.VarChar(64)
  userAgent          String?               @map("user_agent") @db.VarChar(400)
  requestedAt        DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  signedAt           DateTime?             @map("signed_at") @db.Timestamptz(3)
  verifiedAt         DateTime?             @map("verified_at") @db.Timestamptz(3)
  lastSyncedAt       DateTime?             @map("last_synced_at") @db.Timestamptz(3)
  lastError          String?               @map("last_error") @db.VarChar(500)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, signerRole])
  @@index([status, provider])
  @@index([sourceVersionId])
  @@map("digital_signatures")
}

// ───────────────────────────── Phase 9: bank submission, sanction, disbursement ─────────────────────────────

enum SubmissionMode {
  DIGITAL
  PHYSICAL
  BOTH
}

enum SanctionOutcome {
  SANCTIONED
  DECLINED
}

/// Submission of the signed report to the bank / NBFC (digital and / or physical), with acknowledgement.
model BankSubmission {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId          String         @map("firm_id") @db.Uuid
  caseId          String         @map("case_id") @db.Uuid
  mode            SubmissionMode
  submittedOn     DateTime       @map("submitted_on") @db.Date
  submittedTo     String?        @map("submitted_to") @db.VarChar(150)
  ackNumber       String?        @map("ack_number") @db.VarChar(80)
  ackDocumentId   String?        @map("ack_document_id") @db.Uuid
  signedVersionId String?        @map("signed_version_id") @db.Uuid
  remarks         String?        @db.VarChar(1000)
  submittedById   String         @map("submitted_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@index([caseId, submittedOn])
  @@map("bank_submissions")
}

/// The lender's decision (one per case).
model LoanSanction {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId           String          @map("firm_id") @db.Uuid
  caseId           String          @unique @map("case_id") @db.Uuid
  outcome          SanctionOutcome
  amount           Decimal?        @db.Decimal(18, 2)
  sanctionDate     DateTime        @map("sanction_date") @db.Date
  referenceNo      String?         @map("reference_no") @db.VarChar(80)
  letterDocumentId String?         @map("letter_document_id") @db.Uuid
  remarks          String?         @db.VarChar(1000)
  recordedById     String          @map("recorded_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@unique([firmId, caseId])
  @@map("loan_sanctions")
}

/// A disbursement tranche; the final tranche moves the case to DISBURSED.
model LoanDisbursement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firmId          String   @map("firm_id") @db.Uuid
  caseId          String   @map("case_id") @db.Uuid
  trancheNo       Int      @map("tranche_no")
  amount          Decimal  @db.Decimal(18, 2)
  disbursedOn     DateTime @map("disbursed_on") @db.Date
  referenceNo     String?  @map("reference_no") @db.VarChar(80)
  proofDocumentId String?  @map("proof_document_id") @db.Uuid
  isFinal         Boolean  @default(false) @map("is_final")
  remarks         String?  @db.VarChar(1000)
  recordedById    String   @map("recorded_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  case ValuationCase @relation(fields: [firmId, caseId], references: [firmId, id], onDelete: Restrict)

  @@unique([caseId, trancheNo])
  @@map("loan_disbursements")
}
