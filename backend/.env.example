# Valuers Ecosystem API — copy to backend/.env and fill in. NEVER commit backend/.env.
NODE_ENV=development
RUN_MODE=all                      # api | worker | all
PORT=4100
APP_NAME=Valuers Ecosystem
WEB_APP_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
TRUST_PROXY=false
SWAGGER_ENABLED=true
LOG_LEVEL=info

# ── PostgreSQL (local service, NOT Docker) ──
# Runtime role: DML only (append-only tables are INSERT/SELECT only).
DATABASE_URL=postgresql://valuers_app:CHANGE_ME@localhost:5432/valuers_ecosystem?schema=public
# Owner role: used by Prisma migrations (directUrl).
DATABASE_MIGRATION_URL=postgresql://valuers_owner:CHANGE_ME@localhost:5432/valuers_ecosystem?schema=public
# Integration tests (migrated + truncated by the test harness).
TEST_DATABASE_URL=postgresql://valuers_app:CHANGE_ME@localhost:5432/valuers_ecosystem_test?schema=public
TEST_DATABASE_MIGRATION_URL=postgresql://valuers_owner:CHANGE_ME@localhost:5432/valuers_ecosystem_test?schema=public

# ── Redis (dedicated Docker container valuers-redis, see infra/redis) ──
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6391/0
REDIS_TEST_DB=1
QUEUE_PREFIX=valuers

# ── Auth ──
JWT_ACCESS_SECRET=                # >= 64 random characters
JWT_ACCESS_TTL_SECONDS=600
JWT_ISSUER=valuers-api
JWT_AUDIENCE=valuers-web
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false               # must be true in production (HTTPS)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ── Encryption at rest (PAN, SMTP secrets) ──
DATA_ENCRYPTION_KEY=              # 32 random bytes, base64
HMAC_KEY=                         # >= 32 random characters

# ── Document storage ──
STORAGE_DRIVER=local              # local | s3
STORAGE_LOCAL_ROOT=./storage
SIGNED_URL_TTL_SECONDS=60
UPLOAD_MAX_MB=25
S3_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=valuers/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Mail (Gmail SMTP or Microsoft 365) ──
MAIL_PROVIDER=log                 # log | gmail | office365
MAIL_FROM="Valuers Ecosystem <no-reply@example.com>"
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=

# ── Malware scanning ──
SCANNER=none                      # none | clamav (clamav required in production)
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# ── Rate limits (per IP, per minute) ──
THROTTLE_LIMIT_PER_MINUTE=300
AUTH_THROTTLE_LIMIT_PER_MINUTE=20

# ── Bootstrap ──
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_NAME=Platform Administrator
