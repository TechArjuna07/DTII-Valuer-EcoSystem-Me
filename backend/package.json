{
  "name": "@valuers/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Valuers Ecosystem API - Node.js + Express (ES modules) + PostgreSQL (Prisma) + Redis",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:test": "node scripts/migrate-test.js",
    "db:seed": "node prisma/seed/index.js",
    "db:seed:superadmin": "node prisma/seed/superadmin.js",
    "db:status": "prisma migrate status"
  },
  "prisma": {
    "seed": "node prisma/seed/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2",
    "nodemailer": "^7",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0"
  }
}
